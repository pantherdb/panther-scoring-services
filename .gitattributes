# Store text files with LF on every machine, whatever the developer's OS.
* text=auto eol=lf

# Binary files: never convert or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf  binary
*.gz   binary
*.zip  binary

# Generated by `npm run api:types` from the API's OpenAPI schema. GitHub collapses it in diffs.
frontend/src/app/api/schema.d.ts linguist-generated=true

# Generated by `uv run python -m panther_api.openapi` (from api/). GitHub collapses it in diffs.
api/openapi.json linguist-generated=true

# Engine developer: once the golden-files folder is chosen, add a line like
#   engine/tests/golden/** -text
# so git stores them byte for byte. Parity compares them exactly.
