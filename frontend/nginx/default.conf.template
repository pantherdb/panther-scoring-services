# The web image's site: the built files, and /api/ forwarded to the API. The entrypoint writes
# this to /etc/nginx/conf.d/default.conf, with API_UPSTREAM filled in. HTTPS is the server's front
# end's job, not this one's.
server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /srv/site;
    server_tokens off;

    # A little over the API's own limit (PANTHER_API_MAX_BODY_BYTES, 16 MiB), so the API answers
    # an oversized body itself, with its problem details.
    client_max_body_size 17m;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite names each asset by its content, so a new build gets new names.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Anything that isn't a file is a page of the app: index.html, revalidated on each load so a
    # new build shows at once.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
