{
  "openapi": "3.1.0",
  "info": {
    "title": "PANTHER Scoring Services API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness check",
        "description": "Answer 200 while the process can serve requests. Checks no data, tools or engine.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/versions": {
      "get": {
        "tags": [
          "versions"
        ],
        "summary": "API, engine and tool versions",
        "description": "The versions read when the app started. A missing tool has a null version. Runs no tool.",
        "operationId": "versions_api_v1_versions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Versions"
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Start a job",
        "description": "Start a job for `service` with its `input`. The job runs after this request returns.\n\nAn input the job can't run with is a 422, and no job is created. A problem only the work can\nfind, such as a `csnp` sequence BLAST+ can't read, fails the job with a 422 `error`. A valid\n`refmap` request gets a 501 until its mapping is available; its input is still validated first.",
        "operationId": "create_job_api_v1_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ToolsJobRequest"
                  },
                  {
                    "$ref": "#/components/schemas/CsnpJobRequest"
                  },
                  {
                    "$ref": "#/components/schemas/RefmapJobRequest"
                  }
                ],
                "title": "Job Request",
                "discriminator": {
                  "propertyName": "service",
                  "mapping": {
                    "tools": "#/components/schemas/ToolsJobRequest",
                    "csnp": "#/components/schemas/CsnpJobRequest",
                    "refmap": "#/components/schemas/RefmapJobRequest"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "The job was accepted. Poll it at `Location`.",
            "headers": {
              "Location": {
                "description": "The job's path, `/api/v1/jobs/{job_id}`",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ToolsJob"
                    },
                    {
                      "$ref": "#/components/schemas/CsnpJob"
                    },
                    {
                      "$ref": "#/components/schemas/RefmapJob"
                    }
                  ],
                  "title": "Response Create Job Api V1 Jobs Post",
                  "discriminator": {
                    "propertyName": "service",
                    "mapping": {
                      "tools": "#/components/schemas/ToolsJob",
                      "csnp": "#/components/schemas/CsnpJob",
                      "refmap": "#/components/schemas/RefmapJob"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "501": {
            "description": "The service can't run jobs yet: `refmap`, until its mapping is ported. The request was valid, and no job was created.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "A job's status and result",
        "description": "The job's current state. An unknown, invalid or expired id is a 404.",
        "operationId": "get_job_api_v1_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ToolsJob"
                    },
                    {
                      "$ref": "#/components/schemas/CsnpJob"
                    },
                    {
                      "$ref": "#/components/schemas/RefmapJob"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "service",
                    "mapping": {
                      "tools": "#/components/schemas/ToolsJob",
                      "csnp": "#/components/schemas/CsnpJob",
                      "refmap": "#/components/schemas/RefmapJob"
                    }
                  },
                  "title": "Response Get Job Api V1 Jobs  Job Id  Get"
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/csnp/species": {
      "get": {
        "tags": [
          "csnp"
        ],
        "summary": "The species cSNP scores against",
        "description": "Every species a `csnp` job's `species` may name, with its name, in the engine's order.\n\nNeeds no data folder. The response may be cached for an hour.",
        "operationId": "csnp_species_api_v1_csnp_species_get",
        "responses": {
          "200": {
            "description": "Every species, in the engine's order.",
            "headers": {
              "Cache-Control": {
                "description": "`public, max-age=3600`",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CsnpSpecies"
                  },
                  "type": "array",
                  "title": "Response Csnp Species Api V1 Csnp Species Get"
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CsnpInput": {
        "properties": {
          "sequence": {
            "type": "string",
            "maxLength": 1000000,
            "title": "Sequence"
          },
          "substitutions": {
            "items": {
              "type": "string",
              "maxLength": 32,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Substitutions"
          },
          "species": {
            "type": "string",
            "title": "Species"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence",
          "substitutions",
          "species"
        ],
        "title": "CsnpInput",
        "description": "One protein, the substitutions to score in it, and its species.\n\n`sequence` is the protein, as plain residues or FASTA with one header line. Whitespace and\nthe header are removed and letters upper-cased before scoring. `substitutions` are tokens such\nas `L46P`, positions counted from 1 in this sequence; each is upper-cased and must be a\nresidue letter, a position and a residue letter. One that can't be mapped onto the sequence,\nsuch as a wrong wild-type residue, is reported in the result, not rejected. `species` is a\nPANTHER species code such as `HUMAN`, one of the species in cSNP's data."
      },
      "CsnpJob": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "service": {
            "type": "string",
            "const": "csnp",
            "title": "Service"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CsnpResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "$ref": "#/components/schemas/Versions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "service",
          "status",
          "created_at",
          "started_at",
          "finished_at",
          "result",
          "error",
          "versions"
        ],
        "title": "CsnpJob",
        "description": "A `csnp` job, with the same fields as every job. `result` is its PANTHER-PSEP scores.\n\nIt fails with a 422 `error` when the engine can't read the sequence, and with the generic 500\notherwise."
      },
      "CsnpJobRequest": {
        "properties": {
          "service": {
            "type": "string",
            "const": "csnp",
            "title": "Service"
          },
          "input": {
            "$ref": "#/components/schemas/CsnpInput"
          }
        },
        "type": "object",
        "required": [
          "service",
          "input"
        ],
        "title": "CsnpJobRequest",
        "description": "Start a `csnp` job: score substitutions in one protein with PANTHER-PSEP."
      },
      "CsnpResult": {
        "properties": {
          "family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family"
          },
          "scores": {
            "items": {
              "$ref": "#/components/schemas/SubstitutionScore"
            },
            "type": "array",
            "title": "Scores"
          }
        },
        "type": "object",
        "required": [
          "family",
          "scores"
        ],
        "title": "CsnpResult",
        "description": "The PANTHER family the protein was placed in, null with no family hit, and the scores."
      },
      "CsnpSpecies": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "title": "CsnpSpecies",
        "description": "A species cSNP scores against: its PANTHER species code, such as `HUMAN`, and its\nscientific name, such as `Homo sapiens`. The code is what a `csnp` request's `species` names."
      },
      "DataVersion": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "panther": {
            "type": "string",
            "title": "Panther"
          }
        },
        "type": "object",
        "required": [
          "service",
          "panther"
        ],
        "title": "DataVersion",
        "description": "The PANTHER release whose data a scoring service reads, such as \"9\" for cSNP's frozen\nPANTHER 9 data. It names the release the engine reads, not whether the data is installed."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "IdMapping": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "panther_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Panther Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "panther_id"
        ],
        "title": "IdMapping",
        "description": "One ID and the PANTHER ID it maps to, such as `PTHR10078:SF1`.\n\n`panther_id` is null for an ID with no PANTHER ID, where the legacy service said `NOHIT`."
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed"
        ],
        "title": "JobStatus",
        "description": "Where a job is. It only moves forward: queued, running, then succeeded or failed."
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status",
          "detail"
        ],
        "title": "Problem",
        "description": "An RFC 9457 problem details body."
      },
      "RefmapInput": {
        "properties": {
          "organism": {
            "type": "string",
            "maxLength": 5,
            "pattern": "^[A-Z0-9]{1,5}$",
            "title": "Organism"
          },
          "ids": {
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[!-~]+$"
            },
            "type": "array",
            "maxItems": 100000,
            "minItems": 1,
            "title": "Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "organism",
          "ids"
        ],
        "title": "RefmapInput",
        "description": "One organism, and the IDs to map to PANTHER IDs in it.\n\n`organism` is a UniProt species code such as `HUMAN`. `ids` are the protein IDs, such as\nUniProt accessions, each looked up exactly as given: not trimmed, not upper-cased, and\nrepeated IDs each get their own mapping, in order."
      },
      "RefmapJob": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "service": {
            "type": "string",
            "const": "refmap",
            "title": "Service"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RefmapResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "$ref": "#/components/schemas/Versions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "service",
          "status",
          "created_at",
          "started_at",
          "finished_at",
          "result",
          "error",
          "versions"
        ],
        "title": "RefmapJob",
        "description": "A `refmap` job, with the same fields as every job. `result` is its ID mappings.\n\nNone is created until the engine's mapping is wired in: a valid request gets a 501."
      },
      "RefmapJobRequest": {
        "properties": {
          "service": {
            "type": "string",
            "const": "refmap",
            "title": "Service"
          },
          "input": {
            "$ref": "#/components/schemas/RefmapInput"
          }
        },
        "type": "object",
        "required": [
          "service",
          "input"
        ],
        "title": "RefmapJobRequest",
        "description": "Start a `refmap` job: map protein IDs to PANTHER IDs for one organism.\n\nUntil the engine's refmap mapping is wired in, a valid request gets a 501, and no job."
      },
      "RefmapResult": {
        "properties": {
          "mappings": {
            "items": {
              "$ref": "#/components/schemas/IdMapping"
            },
            "type": "array",
            "title": "Mappings"
          }
        },
        "type": "object",
        "required": [
          "mappings"
        ],
        "title": "RefmapResult",
        "description": "One mapping per submitted ID, in the order submitted, repeated IDs included."
      },
      "SubstitutionScore": {
        "properties": {
          "substitution": {
            "type": "string",
            "title": "Substitution"
          },
          "age": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "pdel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pdel"
          }
        },
        "type": "object",
        "required": [
          "substitution",
          "age",
          "message",
          "pdel"
        ],
        "title": "SubstitutionScore",
        "description": "One substitution's score, as the legacy service reported it.\n\n`age` is how long the position has been preserved, in millions of years, and `pdel` the\nprobability of a deleterious effect as the legacy two-decimal string, such as \"0.50\". Either\nmay be null, as when the substitution wasn't scored. `message` is the legacy text: the\nprediction, or why it wasn't scored."
      },
      "ToolVersion": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "title": "ToolVersion",
        "description": "An external tool and the version it reports: null if it's missing or can't be read."
      },
      "ToolsInput": {
        "properties": {},
        "additionalProperties": false,
        "type": "object",
        "title": "ToolsInput",
        "description": "The `tools` job takes no input: `{}`."
      },
      "ToolsJob": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "service": {
            "type": "string",
            "const": "tools",
            "title": "Service"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolsResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "$ref": "#/components/schemas/Versions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "service",
          "status",
          "created_at",
          "started_at",
          "finished_at",
          "result",
          "error",
          "versions"
        ],
        "title": "ToolsJob",
        "description": "A `tools` job. Times are UTC, and null until reached.\n\n`result` is null unless the job succeeded, and `error` is null unless it failed. `versions`\nare the API, engine and tool versions the job ran with."
      },
      "ToolsJobRequest": {
        "properties": {
          "service": {
            "type": "string",
            "const": "tools",
            "title": "Service"
          },
          "input": {
            "$ref": "#/components/schemas/ToolsInput"
          }
        },
        "type": "object",
        "required": [
          "service",
          "input"
        ],
        "title": "ToolsJobRequest",
        "description": "Start a `tools` job: report the external tools' versions from a worker process."
      },
      "ToolsResult": {
        "properties": {
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolVersion"
            },
            "type": "array",
