// Markdown lint for every doc in the repo. Run it with `npx markdownlint-cli2` from the root.
{
  "config": {
    "default": true,
    // The docs keep one paragraph per line.
    "MD013": false,
    // Inline HTML isn't used, but it's harmless.
    "MD033": false
  },
  "globs": ["**/*.md", ".github/**/*.md"],
  "ignores": [
    "**/node_modules/**",
    // Generated by `openspec init`; regenerated on upgrade.
    ".claude/**",
    ".agents/**",
    "frontend/dist/**",
    "frontend/playwright-report/**",
    "frontend/test-results/**"
  ]
}
