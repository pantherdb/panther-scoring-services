# Personal Claude Code settings. Shared settings live in .claude/settings.json.
.claude/settings.local.json
CLAUDE.local.md

# Node
node_modules/

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# The developer's data folder (PANTHER_DATA_DIR): fetched data, never committed. The committed
# .gitkeep makes the folder exist before compose mounts it.
/.data/*
!/.data/.gitkeep

# Build and test output
dist/
test-results/
playwright-report/

# Personal env overrides (e.g. API_PROXY_TARGET). The committed .env.<mode> files hold only mode flags.
*.local
