# The web image's site: the built files, and /api/ forwarded to the API. The entrypoint writes
# this to /etc/nginx/conf.d/default.conf, inside nginx's http block, with API_UPSTREAM and
# NGINX_LOCAL_RESOLVERS filled in. HTTPS is the server's front end's job, not this one's.

# The scheme the user's request came in with: the front end's X-Forwarded-Proto when it sends one,
# such as https, or this server's own.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

server {
    # IPv4 only, like Docker's default networks. An IPv6 listen stops nginx on a host whose
    # kernel has IPv6 turned off.
    listen 8080;
    server_name _;
    root /srv/site;
    server_tokens off;

    # A little over the API's own limit (PANTHER_API_MAX_BODY_BYTES, 16 MiB), so the API answers
    # an oversized body itself, with its problem details. A front end before this needs as much.
    client_max_body_size 17m;

    # Docker's DNS, from the container's resolv.conf. With the API's address in a variable, nginx
    # looks its name up again when the answer expires, so a new API container, with a new IP, is
    # found without restarting this one.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        # A variable with no path, so the request's own path goes to the API unchanged.
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # What the user's request came with, passed on: the host with its port, and the scheme
        # the front end saw.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Vite names each asset by its content, so a new build gets new names.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Anything that isn't a file is a page of the app: index.html, revalidated on each load so a
    # new build shows at once.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
