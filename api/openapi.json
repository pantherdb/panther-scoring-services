{
  "openapi": "3.1.0",
  "info": {
    "title": "PANTHER Scoring Services API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness check",
        "description": "Answer 200 while the process can serve requests. Checks no data, tools or engine.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/versions": {
      "get": {
        "tags": [
          "versions"
        ],
        "summary": "API, engine and tool versions",
        "description": "The versions read when the app started. A missing tool has a null version. Runs no tool.",
        "operationId": "versions_api_v1_versions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Versions"
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Start a job",
        "description": "Start a job for `service` with its `input`. The job runs after this request returns.\n\nAn input the job can't run with is a 422, and no job is created. A problem only the work can\nfind, such as a `csnp` sequence BLAST+ can't read, fails the job with a 422 `error`. A valid\nrequest is a 503 when too many jobs are already waiting for a worker. A valid `hmmscore`\nrequest gets a 501 until its scoring is available; its input, and its residue limit, are still\nvalidated first.",
        "operationId": "create_job_api_v1_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ToolsJobRequest"
                  },
                  {
                    "$ref": "#/components/schemas/CsnpJobRequest"
                  },
                  {
                    "$ref": "#/components/schemas/RefmapJobRequest"
                  },
                  {
                    "$ref": "#/components/schemas/HmmscoreJobRequest"
                  }
                ],
                "title": "Job Request",
                "discriminator": {
                  "propertyName": "service",
                  "mapping": {
                    "tools": "#/components/schemas/ToolsJobRequest",
                    "csnp": "#/components/schemas/CsnpJobRequest",
                    "refmap": "#/components/schemas/RefmapJobRequest",
                    "hmmscore": "#/components/schemas/HmmscoreJobRequest"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "The job was accepted. Poll it at `Location`.",
            "headers": {
              "Location": {
                "description": "The job's path, `/api/v1/jobs/{job_id}`",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ToolsJob"
                    },
                    {
                      "$ref": "#/components/schemas/CsnpJob"
                    },
                    {
                      "$ref": "#/components/schemas/RefmapJob"
                    },
                    {
                      "$ref": "#/components/schemas/HmmscoreJob"
                    }
                  ],
                  "title": "Response Create Job Api V1 Jobs Post",
                  "discriminator": {
                    "propertyName": "service",
                    "mapping": {
                      "tools": "#/components/schemas/ToolsJob",
                      "csnp": "#/components/schemas/CsnpJob",
                      "refmap": "#/components/schemas/RefmapJob",
                      "hmmscore": "#/components/schemas/HmmscoreJob"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "As many jobs are waiting for a worker as the API allows (`PANTHER_API_MAX_QUEUED_JOBS`). The request was valid, and no job was created.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before submitting again",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "501": {
            "description": "The service can't run jobs yet: `hmmscore`, until its scoring is ported. The request was valid, and no job was created.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          },
          "413": {
            "description": "The request body is over the API's limit (`PANTHER_API_MAX_BODY_BYTES`, 16 MiB by default). It was refused before it was processed.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "A job's status and result",
        "description": "The job's current state. An unknown, invalid or expired id is a 404.",
        "operationId": "get_job_api_v1_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ToolsJob"
                    },
                    {
                      "$ref": "#/components/schemas/CsnpJob"
                    },
                    {
                      "$ref": "#/components/schemas/RefmapJob"
                    },
                    {
                      "$ref": "#/components/schemas/HmmscoreJob"
                    }
                  ],
                  "discriminator": {
                    "propertyName": "service",
                    "mapping": {
                      "tools": "#/components/schemas/ToolsJob",
                      "csnp": "#/components/schemas/CsnpJob",
                      "refmap": "#/components/schemas/RefmapJob",
                      "hmmscore": "#/components/schemas/HmmscoreJob"
                    }
                  },
                  "title": "Response Get Job Api V1 Jobs  Job Id  Get"
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/csnp/species": {
      "get": {
        "tags": [
          "csnp"
        ],
        "summary": "The species cSNP scores against",
        "description": "Every species a `csnp` job's `species` may name, with its name, in the engine's order.\n\nNeeds no data folder. The response may be cached for an hour.",
        "operationId": "csnp_species_api_v1_csnp_species_get",
        "responses": {
          "200": {
            "description": "Every species, in the engine's order.",
            "headers": {
              "Cache-Control": {
                "description": "`public, max-age=3600`",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CsnpSpecies"
                  },
                  "type": "array",
                  "title": "Response Csnp Species Api V1 Csnp Species Get"
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/refmap/organisms": {
      "get": {
        "tags": [
          "refmap"
        ],
        "summary": "The organisms refmap maps for",
        "description": "Every organism a `refmap` job's `organism` may name, with its name and gene counts, in the\nengine's order.\n\nNeeds no data folder. The response may be cached for an hour.",
        "operationId": "refmap_organisms_api_v1_refmap_organisms_get",
        "responses": {
          "200": {
            "description": "Every organism, in the engine's order.",
            "headers": {
              "Cache-Control": {
                "description": "`public, max-age=3600`",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RefmapOrganism"
                  },
                  "type": "array",
                  "title": "Response Refmap Organisms Api V1 Refmap Organisms Get"
                }
              }
            }
          },
          "default": {
            "description": "Error, as problem details",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CsnpInput": {
        "properties": {
          "sequence": {
            "type": "string",
            "maxLength": 1000000,
            "title": "Sequence"
          },
          "substitutions": {
            "items": {
              "type": "string",
              "maxLength": 32,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Substitutions"
          },
          "species": {
            "type": "string",
            "title": "Species"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence",
          "substitutions",
          "species"
        ],
        "title": "CsnpInput",
        "description": "One protein, the substitutions to score in it, and its species.\n\n`sequence` is the protein, as plain residues or FASTA with one header line. Whitespace and\nthe header are removed and letters upper-cased before scoring. `substitutions` are tokens such\nas `L46P`, positions counted from 1 in this sequence; each is upper-cased and must be a\nresidue letter, a position and a residue letter. One that can't be mapped onto the sequence,\nsuch as a wrong wild-type residue, is reported in the result, not rejected. `species` is a\nPANTHER species code such as `HUMAN`, one of the species in cSNP's data."
      },
      "CsnpJob": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "service": {
            "type": "string",
            "const": "csnp",
            "title": "Service"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CsnpResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "$ref": "#/components/schemas/Versions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "service",
          "status",
          "created_at",
          "started_at",
          "finished_at",
          "result",
          "error",
          "versions"
        ],
        "title": "CsnpJob",
        "description": "A `csnp` job, with the same fields as every job. `result` is its PANTHER-PSEP scores.\n\nIt fails with a 422 `error` when the engine can't read the sequence, and with the generic 500\notherwise."
      },
      "CsnpJobRequest": {
        "properties": {
          "service": {
            "type": "string",
            "const": "csnp",
            "title": "Service"
          },
          "input": {
            "$ref": "#/components/schemas/CsnpInput"
          }
        },
        "type": "object",
        "required": [
          "service",
          "input"
        ],
        "title": "CsnpJobRequest",
        "description": "Start a `csnp` job: score substitutions in one protein with PANTHER-PSEP."
      },
      "CsnpResult": {
        "properties": {
          "family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Family"
          },
          "scores": {
            "items": {
              "$ref": "#/components/schemas/SubstitutionScore"
            },
            "type": "array",
            "title": "Scores"
          }
        },
        "type": "object",
        "required": [
          "family",
          "scores"
        ],
        "title": "CsnpResult",
        "description": "The PANTHER family the protein was placed in, null with no family hit, and the scores."
      },
      "CsnpSpecies": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "title": "CsnpSpecies",
        "description": "A species cSNP scores against: its PANTHER species code, such as `HUMAN`, and its\nscientific name, such as `Homo sapiens`. The code is what a `csnp` request's `species` names."
      },
      "DataVersion": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service"
          },
          "panther": {
            "type": "string",
            "title": "Panther"
          }
        },
        "type": "object",
        "required": [
          "service",
          "panther"
        ],
        "title": "DataVersion",
        "description": "The PANTHER release whose data a scoring service reads, such as \"9\" for cSNP's frozen\nPANTHER 9 data, or \"19\" for refmap's. It names the release the engine reads, not whether the\ndata is installed."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "HmmHit": {
        "properties": {
          "panther_id": {
            "type": "string",
            "title": "Panther Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "evalue": {
            "type": "string",
            "title": "Evalue"
          },
          "score": {
            "type": "string",
            "title": "Score"
          },
          "alignment": {
            "type": "string",
            "title": "Alignment"
          }
        },
        "type": "object",
        "required": [
          "panther_id",
          "name",
          "evalue",
          "score",
          "alignment"
        ],
        "title": "HmmHit",
        "description": "The best-scoring PANTHER HMM, as the legacy service reported it, with its name and score.\n\n`panther_id` is the family or subfamily, such as `PTHR10000:SF1`. `name` is its name in the\nlibrary's `names.tab`. `evalue` and `score` are the full-sequence E-value and bit score as\n`hmmscan` printed them. `alignment` is `hmmsearch`'s domain annotation of the sequence against\nthe model, as the legacy page showed it."
      },
      "HmmscoreInput": {
        "properties": {
          "sequence": {
            "type": "string",
            "maxLength": 1000000,
            "title": "Sequence"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sequence"
        ],
        "title": "HmmscoreInput",
        "description": "One protein to score against PANTHER's HMM library.\n\n`sequence` is the protein, as plain residues or FASTA with one header line. Whitespace and the\nheader are removed and letters upper-cased before scoring. It may hold only the letters A to\nZ, and a single `*` at the end. It may have at most as many residues as the API is configured\nto take, 10,000 by default and never more; a final `*` isn't counted. A longer sequence is a\n422 naming the limit."
      },
      "HmmscoreJob": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "service": {
            "type": "string",
            "const": "hmmscore",
            "title": "Service"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HmmscoreResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Problem"
              },
              {
                "type": "null"
              }
            ]
          },
          "versions": {
            "$ref": "#/components/schemas/Versions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "service",
          "status",
          "created_at",
          "started_at",
          "finished_at",
          "result",
          "error",
          "versions"
        ],
        "title": "HmmscoreJob",
        "description": "An `hmmscore` job, with the same fields as every job. `result` is the best-scoring\nPANTHER HMM, or a null `hit`.\n\nNone is created until the engine's scoring is wired in: a valid request gets a 501."
      },
      "HmmscoreJobRequest": {
        "properties": {
          "service": {
            "type": "string",
            "const": "hmmscore",
            "title": "Service"
          },
          "input": {
            "$ref": "#/components/schemas/HmmscoreInput"
          }
        },
        "type": "object",
        "required": [
          "service",
          "input"
        ],
        "title": "HmmscoreJobRequest",
        "description": "Start an `hmmscore` job: score one protein against PANTHER's HMM library.\n\nUntil the engine's hmmscore scoring is wired in, a valid request gets a 501, and no job."
      },
      "HmmscoreResult": {
        "properties": {
          "hit": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HmmHit"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "hit"
        ],
        "title": "HmmscoreResult",
        "description": "The best hit, or null when there's none, or the best hit's full-sequence E-value is over\n1e-3, as the legacy service applied its cutoff."
      },
      "IdMapping": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "panther_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Panther Id"
          }
        },
        "type": "object",
        "required": [
          "id",
          "panther_id"
        ],
        "title": "IdMapping",
        "description": "One ID and the PANTHER ID it maps to, such as `PTHR10078:SF1`.\n\n`panther_id` is null for an ID with no PANTHER ID, where the legacy service said `NOHIT`."
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed"
        ],
        "title": "JobStatus",
        "description": "Where a job is. It only moves forward: queued, running, then succeeded or failed."
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status",
          "detail"
        ],
        "title": "Problem",
        "description": "An RFC 9457 problem details body."
      },
      "RefmapInput": {
        "properties": {
          "organism": {
            "type": "string",
            "maxLength": 5,
            "pattern": "^[A-Z0-9]{1,5}$",
            "title": "Organism"
          },
          "ids": {
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[!-~]+$"
            },
            "type": "array",
            "maxItems": 100000,
            "minItems": 1,
            "title": "Ids"
          }
        },
